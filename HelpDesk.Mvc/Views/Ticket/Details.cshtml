@model HelpDesk.Mvc.Models.TicketViewModel
@{
    ViewData["Title"] = "Ticket Details";
}

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h2 fw-bold text-info"><i class="bi bi-eye-fill me-2"></i>Ticket #@Model.Id Details</h1>
            <p class="text-muted">Viewing metadata and technical details of the support ticket</p>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 me-2">
                <i class="bi bi-arrow-left me-2"></i>Back to List
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-4 me-2">
                <i class="bi bi-pencil-square me-2"></i>Edit
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-4">
                <i class="bi bi-trash3 me-2"></i>Delete
            </a>
        </div>
    </div>

    <!-- Ticket Detail Card -->
    <div class="card card-custom border-secondary shadow-lg p-4">
        <div class="row g-4">
            <div class="col-md-8 border-end border-secondary">
                <h3 class="fw-bold text-white mb-3">@Model.Title</h3>
                <h6 class="text-info mb-2 font-monospace text-uppercase" style="font-size: 0.8rem;">Description</h6>
                <div class="bg-dark p-3 rounded text-light mb-4 border border-secondary" style="white-space: pre-wrap; min-height: 150px;">
                    @Model.Description
                </div>
            </div>
            
            <div class="col-md-4 ps-md-4">
                <h5 class="fw-bold text-white mb-4"><i class="bi bi-info-circle-fill me-2 text-info"></i>Metadata</h5>

                <div class="mb-3">
                    <span class="text-muted d-block small font-monospace text-uppercase">Status</span>
                    @if (Model.Status == "Open")
                    {
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-3 py-2 rounded-pill">Open</span>
                    }
                    else if (Model.Status == "In Progress")
                    {
                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 px-3 py-2 rounded-pill">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-2 rounded-pill">Closed</span>
                    }
                </div>

                <div class="mb-3">
                    <span class="text-muted d-block small font-monospace text-uppercase">Priority</span>
                    @if (Model.Priority == "High")
                    {
                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-3 py-2 rounded-pill">High</span>
                    }
                    else if (Model.Priority == "Medium")
                    {
                        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-3 py-2 rounded-pill">Medium</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary bg-opacity-25 text-muted border border-secondary border-opacity-50 px-3 py-2 rounded-pill">Low</span>
                    }
                </div>

                <hr class="border-secondary my-4" />

                <div class="mb-3">
                    <span class="text-muted d-block small font-monospace text-uppercase">Raised By</span>
                    <strong class="text-white">@Model.RaisedBy</strong>
                </div>

                <div class="mb-3">
                    <span class="text-muted d-block small font-monospace text-uppercase">Created Date</span>
                    <strong class="text-white">@Model.CreatedDate.ToLocalTime().ToString("F")</strong>
                </div>
            </div>
        </div>
    </div>
</div>
